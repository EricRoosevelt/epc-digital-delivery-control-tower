{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bim-doctor:phase2-candidate-manifest:1",
  "title": "BIM Doctor public candidate capture manifest",
  "type": "object",
  "required": ["schema_version", "status", "source_sha", "source_tree_verified", "capture_started_utc", "capture_finished_utc", "browser", "platform", "language", "source_files", "media", "scenes", "observations", "page_errors", "blocked_external_requests", "ai", "public_inputs", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["candidate-captured", "rehearsal-not-candidate"]},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_verified": {"type": "boolean"},
    "capture_started_utc": {"type": "string", "format": "date-time"},
    "capture_finished_utc": {"type": "string", "format": "date-time"},
    "browser": {
      "type": "object", "required": ["engine", "channel", "version", "playwright", "headless", "viewport"],
      "properties": {"engine": {"const": "chromium"}, "channel": {"enum": ["chromium", "msedge"]}, "version": {"type": "string"}, "playwright": {"type": "string"}, "headless": {"const": true}, "viewport": {"type": "object"}}
    },
    "platform": {"type": "string"},
    "language": {"enum": ["en", "zh"]},
    "source_files": {"type": "array", "items": {"$ref": "#/$defs/hashedPath"}},
    "media": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/hashedPath"}], "required": ["bytes"], "properties": {"bytes": {"type": "integer", "minimum": 0}}}},
    "scenes": {"type": "array", "minItems": 11, "items": {"type": "object", "required": ["id", "caption", "at_ms", "screenshot"], "properties": {"id": {"type": "string"}, "caption": {"type": "string"}, "at_ms": {"type": "integer", "minimum": 0}, "screenshot": {"$ref": "#/$defs/relativePath"}}}},
    "observations": {"type": "object", "required": ["public_example", "synthetic"]},
    "page_errors": {"type": "array", "maxItems": 0},
    "blocked_external_requests": {"type": "array", "maxItems": 0},
    "ai": {"type": "object", "required": ["configured", "demonstrated_mode", "live_provider_call"], "properties": {"configured": {"const": false}, "demonstrated_mode": {"const": "guidance"}, "live_provider_call": {"const": false}}},
    "public_inputs": {"type": "object", "required": ["buildingsmart", "synthetic"]},
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "candidate-captured"}}}, "then": {"properties": {"source_tree_verified": {"const": true}}}}],
  "$defs": {
    "relativePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "hashedPath": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
